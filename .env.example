# Supabase Postgres connection string.
# Prefer Supabase's pooled connection URL for Vercel/serverless deployments.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require"

# Supabase Auth values. The VITE_ values are designed to be exposed to the browser.
VITE_SUPABASE_URL="https://PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"

# Comma-separated email addresses allowed to use the application.
ADMIN_EMAILS="admin@example.com"

# Keep both values false while the application is shared without login.
# Set both values to true and redeploy when login is required again.
AUTH_REQUIRED="false"
VITE_AUTH_REQUIRED="false"

# Optional analytics placeholders referenced by client/index.html.
VITE_ANALYTICS_ENDPOINT=""
VITE_ANALYTICS_WEBSITE_ID=""
